+fn half_of(f: TextureFormat) -> Option<(TextureFormat, usize)> {
+    use TextureFormat as T;
+    match f {
+        T::R32Float => Some((T::R16Float, 1)),
+        T::Rg32Float => Some((T::Rg16Float, 2)),
+        T::Rgba32Float => Some((T::Rgba16Float, 4)),
+        _ => None,
+    }
+}
