+    fn suspended(&mut self, _el: &ActiveEventLoop) {
+        gpu::SUSPENDED.store(true, std::sync::atomic::Ordering::Relaxed);
+        input::set_focus(false);
+        #[cfg(target_os = "ios")]
+        crate::touch::release();
+    }
