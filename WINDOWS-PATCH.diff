+pub fn footprint_mb() -> u64 {
+    extern "C" {
+        fn proc_pid_rusage(pid: i32, flavor: i32, buffer: *mut u64) -> i32;
+        fn getpid() -> i32;
+    }
+
+    let mut info = [0u64; 16];
+    if unsafe { proc_pid_rusage(getpid(), 0, info.as_mut_ptr()) } != 0 {
+        return 0;
+    }
+    info[2 + 7] >> 20
+}
