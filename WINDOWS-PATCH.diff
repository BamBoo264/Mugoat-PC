+pub fn alert(title: &str, msg: &str) {
+    let script = format!("display alert \"{}\" message \"{}\" as critical",
+        title.replace('"', "'"), msg.replace('"', "'"));
+    let _ = std::process::Command::new("osascript").args(["-e", &script]).status();
+}
