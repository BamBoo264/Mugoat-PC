+    if in_car {
+        if p.ly>9830 {keys.insert("Numpad8");}if p.ly < -9830 {keys.insert("Numpad2");}
+        if p.rt>51 {keys.insert("KeyW");}if p.lt>51 {keys.insert("KeyS");}
+        if down(0x0200)||down(0x4000) {keys.insert("Space");}
