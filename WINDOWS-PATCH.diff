+fn format_id(f: TextureFormat) -> i64 {
+    let s = format!("{f:?}");
+    let mut h: i64 = 1469598103934665603u64 as i64;
+    for b in s.bytes() { h = (h ^ b as i64).wrapping_mul(1099511628211); }
