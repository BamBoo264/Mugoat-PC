+        if text[w[0].end()..w[1].start()].trim() != "," { continue; }
+        let (Some(&t), Some(&smp)) = (names.get(w[0].as_str()), names.get(w[1].as_str())) else { continue };
+        if t < 128 && textures & (1 << t) != 0 && smp < 128 { out |= 1 << smp; }
+    }
+    out
+}
