+            let mut gpu = match Gpu::new(mem.clone(), ring, size, dbg, handoff) {
+                Ok(g) => g,
+                Err(e) => {
+                    log(&format!("init failed: {e:#}"));
+                    crate::app::engine_error(format!("Cannot initialize graphics: {e:#}"));
+                    drain_forever(&mem, ring);
